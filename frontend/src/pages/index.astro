---
import Layout from '../layouts/Layout.astro';
---

<Layout title="10code - Inicio">
  <section class="hero">
    <h1>Bienvenido a 10code</h1>
    <p>Desarrollo web profesional con las últimas tecnologías</p>
    <div class="cta-buttons">
      <a href="/servicios" class="btn btn-primary">Ver Servicios</a>
      <a href="/contacto" class="btn btn-secondary">Contáctanos</a>
    </div>
  </section>

  <section class="features">
    <h2>¿Por qué elegirnos?</h2>
    <div class="features-grid">
      <div class="feature">
        <h3>Experiencia</h3>
        <p>Años de experiencia en desarrollo web moderno</p>
      </div>
      <div class="feature">
        <h3>Tecnología</h3>
        <p>Utilizamos las últimas tecnologías y mejores prácticas</p>
      </div>
      <div class="feature">
        <h3>Soporte</h3>
        <p>Acompañamiento continuo en tu proyecto</p>
      </div>
    </div>
  </section>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 4rem 0;
  }

  .hero h1 {
    font-size: 3rem;
    margin-bottom: 1rem;
    color: var(--color-primary);
  }

  .hero p {
    font-size: 1.5rem;
    margin-bottom: 2rem;
    color: #666;
  }

  .cta-buttons {
    display: flex;
    gap: 1rem;
    justify-content: center;
    flex-wrap: wrap;
  }

  .btn {
    display: inline-block;
    padding: 0.75rem 2rem;
    text-decoration: none;
    border-radius: 4px;
    font-weight: 600;
    transition: all 0.3s;
  }

  .btn-primary {
    background-color: var(--color-primary);
    color: white;
  }

  .btn-primary:hover {
    background-color: #0052a3;
  }

  .btn-secondary {
    background-color: transparent;
    color: var(--color-primary);
    border: 2px solid var(--color-primary);
  }

  .btn-secondary:hover {
    background-color: var(--color-primary);
    color: white;
  }

  .features {
    margin-top: 4rem;
  }

  .features h2 {
    text-align: center;
    font-size: 2rem;
    margin-bottom: 3rem;
  }

  .features-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }

  .feature {
    padding: 2rem;
    background-color: #f9f9f9;
    border-radius: 8px;
    text-align: center;
  }

  .feature h3 {
    color: var(--color-primary);
    margin-bottom: 1rem;
  }
</style>
